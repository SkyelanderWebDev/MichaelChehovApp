{
  "name": "chekhov-toolkit-ionic",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "verify:build-version": "node scripts/verify-build-version.mjs",
    "verify:build-bump": "node scripts/verify-build-bump-required.mjs",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:e2e:ci": "start-server-and-test \"vite --host 127.0.0.1\" http://127.0.0.1:5173 \"npm run test:e2e\"",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "verify:rls": "node scripts/verify-supabase-rls.mjs",
    "verify:rls:chat": "node scripts/verify-chat-rls.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.4.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/status-bar": "8.0.2",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "@supabase/supabase-js": "^2.108.1",
    "ionicons": "^7.0.0",
    "jspdf": "^4.2.1",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.0",
    "@vitejs/plugin-legacy": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "cypress": "^15.18.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "start-server-and-test": "^3.0.11",
    "terser": "^5.4.0",
    "typescript": "~5.9.0",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.1.10"
  },
  "description": "An Ionic project",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.7"
    }
  }
}
